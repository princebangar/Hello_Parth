{
  "expo": {
    "name": "Hello Parth",
    "slug": "hello-parth-user",
    "scheme": "helloparth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B172A",
    "android": {
      "package": "com.helloparth.user",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-sharing",
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B172A",
          "dark": {
            "backgroundColor": "#0B172A"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hello Parth uses your location to find pickup points, nearby restaurants and delivery addresses."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hello Parth needs your photos to upload a profile picture or attach images.",
          "cameraPermission": "Hello Parth needs the camera to take a profile picture or attach images."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#dc2626"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hello Parth uses the microphone for voice search.",
          "speechRecognitionPermission": "Hello Parth uses speech recognition for voice search."
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "process.env.EXPO_PUBLIC_GOOGLE_MAPS_API_KEY"
        }
      ],
      "./plugins/withReleaseSigning.js",
      "./plugins/withShortCmakeObjectPaths.js",
      "./plugins/withReleaseNoMinify.js"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
